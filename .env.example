# =====================================================================
#  TECH CITY TECHNOLOGY — environment variables
#  Copy this file to `.env` and fill in the values you need.
#      cp .env.example .env
#  Only variables prefixed with VITE_ are exposed to the browser.
#  NEVER put secret keys (service_role, private API keys) in this file.
# =====================================================================

# ---------------------------------------------------------------------
# Demo / sample data
# ---------------------------------------------------------------------
# The seed dataset (10 customers, 20 services, 5 equipment records) can only be
# loaded when running `npm run dev`, or when this flag is explicitly "true".
# Leave it unset/false in production so demo rows never appear for a real business.
VITE_ENABLE_DEMO_DATA=false


# ---------------------------------------------------------------------
# OPTIONAL — Supabase (multi-device / cloud sync)
# ---------------------------------------------------------------------
# The app works fully offline with local browser storage and needs NOTHING here.
# Provide these only if you migrate to the Supabase backend
# (apply supabase/schema.sql first — see README → "Optional: Supabase").
#
# Find them at: Supabase Dashboard → Project Settings → API
# The anon key is safe to expose in the browser ONLY because every table is
# protected by the Row Level Security policies defined in supabase/schema.sql.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=


# ---------------------------------------------------------------------
# OPTIONAL — WhatsApp Business Cloud API
# ---------------------------------------------------------------------
# NOT REQUIRED. Without these the app uses the built-in manual workflow:
# a wa.me deep link opens WhatsApp with a pre-filled message and the PDF is
# downloaded / shared through the OS share sheet so you attach it in one tap.
#
# Automatic PDF delivery needs a Meta-approved WhatsApp Business account,
# an approved message template and a publicly hosted media URL. These
# placeholders exist so you know exactly what an integration would require.
VITE_WHATSAPP_PHONE_NUMBER_ID=
VITE_WHATSAPP_TEMPLATE_NAME=
# The access token must live on a SERVER, never in the frontend.
# WHATSAPP_ACCESS_TOKEN=
